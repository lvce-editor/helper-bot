{
  "name": "@lvce-editor/helper-bot-monorepo",
  "version": "0.0.0-dev",
  "description": "GitHub App to automaticlly update lvce editor extensions to latest versions.",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "dev": "npm run dev --workspace=@lvce-editor/helper-bot",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "start": "npm start --workspace=@lvce-editor/helper-bot",
    "test": "npm test --workspaces --if-present"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 160
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@lvce-editor/eslint-config": "^18.0.0",
    "@lvce-editor/eslint-plugin-tsconfig": "^17.6.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "knip": "^6.29.0",
    "nock": "^14.0.16",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  }
}
